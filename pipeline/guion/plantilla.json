{
  "proyecto": "plantilla_cinematica",
  "titulo": "Plantilla de 7 escenas (~31 s). Copia este archivo, cambia los textos y prompts, y ajusta los backends.",
  "formato": { "ancho": 1080, "alto": 1920, "fps": 30 },
  "estilo": { "look": "neon_nocturno", "grano": 6, "vineta": true, "paleta": ["#FF2E93", "#1FB6FF", "#B07CFF", "#FFB02E"] },
  "audio": { "musica": { "archivo": "audio/musica.wav", "volumen_db": -18, "fade_in": 0.4, "fade_out": 1.5 }, "ducking": true, "lufs": -14 },
  "escenas": [
    { "id": "e01", "duracion": 3.0, "backend": "blender",
      "prompt_visual": "Calle neón nocturna con lluvia, asfalto mojado con reflejos, bruma volumétrica, auto deportivo original al fondo",
      "camara": { "tipo": "dolly_in", "lente_mm": 28, "apertura_f": 2.8 },
      "movimiento": { "zoom": { "desde": 1.0, "hasta": 1.12, "curva": "ease_out" } },
      "texto": { "contenido": "TÍTULO DE APERTURA", "estilo": "slam", "color": "#FFFFFF", "posicion": "centro", "inicio": 0.2, "fin": 2.7 },
      "voz": { "texto": "Frase de la voz en off de la escena 1.", "archivo": "voz/e01.wav", "inicio": 0.1 },
      "sfx": [{ "archivo": "sfx/golpe_bajo.wav", "t": 0.0, "volumen_db": -4 }],
      "efectos": [{ "tipo": "flash", "t": 0.0, "intensidad": 0.8 }, "bloom"],
      "transicion": { "tipo": "fadeblack", "duracion": 0.4 },
      "ajustes": { "blender": { "samples": 48, "personajes": 2, "lluvia": true } } },
    { "id": "e02", "duracion": 5.0, "backend": "comfy_t2v",
      "prompt_visual": "Aerial view of a fictional coastal city at night, neon skyscrapers, palm trees, beach, cinematic lighting, volumetric haze",
      "prompt_negativo": "text, watermark, logo, blurry, low quality, deformed",
      "camara": { "tipo": "dolly_in", "lente_mm": 24, "apertura_f": 4 },
      "movimiento": { "zoom": { "desde": 1.0, "hasta": 1.1, "curva": "lineal" } },
      "texto": { "contenido": "SEGUNDA ESCENA", "estilo": "pop", "color": "#FFE86A" },
      "voz": { "texto": "Frase de la voz en off de la escena 2.", "archivo": "voz/e02.wav" },
      "efectos": ["motion_blur", "bloom"],
      "transicion": { "tipo": "wipeleft", "duracion": 0.4 },
      "ajustes": { "comfy": { "steps": 30, "cfg": 6, "si_corto": "congelar" } } },
    { "id": "e03", "duracion": 5.0, "backend": "comfy_i2v", "imagen": "imagenes/personaje_original.png",
      "prompt_visual": "An original adult character seen from behind walking toward a neon-lit sports car, slow camera push, rain, cinematic",
      "camara": { "tipo": "dolly_in", "lente_mm": 35, "apertura_f": 2.8 },
      "texto": { "contenido": "PERSONAJES ORIGINALES", "estilo": "slam", "color": "#FF4FA8", "posicion": "arriba" },
      "voz": { "texto": "Frase de la voz en off de la escena 3.", "archivo": "voz/e03.wav" },
      "efectos": [{ "tipo": "shake", "t": 0.0, "duracion": 0.5, "intensidad": 0.5 }],
      "transicion": { "tipo": "slideleft", "duracion": 0.4 } },
    { "id": "e04", "duracion": 5.0, "backend": "blender",
      "prompt_visual": "Persecución estilizada nocturna, auto deportivo original entre el tráfico, luces de sirena genéricas, lluvia",
      "camara": { "tipo": "mano_alzada", "lente_mm": 24, "apertura_f": 2.0 },
      "texto": { "contenido": "ACCIÓN", "estilo": "slam", "color": "#FFFFFF" },
      "voz": { "texto": "Frase de la voz en off de la escena 4.", "archivo": "voz/e04.wav" },
      "sfx": [{ "archivo": "sfx/sirena.wav", "t": 0.0, "volumen_db": -10 }, { "archivo": "sfx/motor.wav", "t": 0.5, "volumen_db": -12 }],
      "efectos": [{ "tipo": "glitch", "t": 2.0, "duracion": 0.25 }, "motion_blur", "bloom"],
      "transicion": { "tipo": "circleopen", "duracion": 0.4 },
      "ajustes": { "blender": { "samples": 48, "motion_blur": true } } },
    { "id": "e05", "duracion": 5.0, "backend": "comfy_t2v",
      "prompt_visual": "Wide aerial of a fictional coastal city at sunset, beach, palm trees, traffic, helicopter, slow orbit, cinematic",
      "camara": { "tipo": "orbita", "lente_mm": 28, "apertura_f": 5.6 },
      "texto": { "contenido": "ATARDECER", "estilo": "fade", "color": "#FFB02E", "posicion": "abajo" },
      "voz": { "texto": "Frase de la voz en off de la escena 5.", "archivo": "voz/e05.wav" },
      "musica": { "archivo": "audio/subida_epica.wav", "volumen_db": -14, "fade_out": 0.8 },
      "transicion": { "tipo": "fadewhite", "duracion": 0.4 } },
    { "id": "e06", "duracion": 6.0, "backend": "lavfi", "ajustes": { "lavfi": { "c0": "#05030F", "c1": "#2A0E5A", "tipo": "radial" } },
      "prompt_visual": "Pantalla minimalista con fecha y plataformas; fondo oscuro con partículas de neón",
      "texto": { "contenido": "00.00.0000 PLATAFORMAS", "estilo": "pop", "color": "#44E6FF" },
      "voz": { "texto": "Frase de la voz en off de la escena 6.", "archivo": "voz/e06.wav" },
      "efectos": [{ "tipo": "glitch", "t": 0.2, "duracion": 0.3, "periodo": 2.0 }],
      "transicion": { "tipo": "pixelize", "duracion": 0.4 } },
    { "id": "e07", "duracion": 4.0, "backend": "lavfi", "ajustes": { "lavfi": { "c0": "#000000", "c1": "#12082E", "tipo": "linear" } },
      "prompt_visual": "Cierre sobre negro con pregunta",
      "texto": { "contenido": "¿Y TÚ QUÉ ELEGIRÁS?", "estilo": "slam", "color": "#FFFFFF" },
      "voz": { "texto": "Frase de cierre.", "archivo": "voz/e07.wav" },
      "sfx": [{ "archivo": "sfx/impacto_final.wav", "t": 0.0 }] }
  ]
}
